{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sse.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/nilein-dashboard", "destination": "/index.html" },
    { "source": "/nilein-dashboard/:path*", "destination": "/index.html" }
  ],
  "outputDirectory": "dist/public"
}
